# COSMOS GROWTH OS — Configuration Template
# Copy this file to .env and adjust as necessary

# Server
COSMOS_HOST=127.0.0.1
COSMOS_PORT=8500

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# Default Settings
DEFAULT_VOICE=hi-IN-MadhurNeural
DEFAULT_CHANNEL_HANDLE=@cosmos-1nr
DEFAULT_PRIVACY=private

# YouTube API (Credentials are automatically read from token.json & client_secret.json in cosmos_shorts)
# To obtain credentials: Create OAuth Desktop Client in Google Cloud Console -> enable YouTube Data API v3.
